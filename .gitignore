.DS_Store
asset/music/gen/*.wav
asset/music/private/*
!asset/music/private/README.md
!asset/music/private/manifest.example.js
__pycache__/

# Research output stays local. CJ, 2026-09-24: 「研究過程不用上傳」.
# The written findings are kept in the worktrees and on Desktop; the screenshots and
# candidate downloads are process, not the page, and they are what makes the repo heavy.
research/*/shots/
research/**/candidates/
research/refs/
research/**/shots-src/

# local-only: Blender/style experiments and video transcripts kept out of the repo
asset/attic/
research/transcripts/

# Blender scene exports — the .blend files and renders stay local
render/
*.blend
*.blend1

# bundling: the per-model sources are inputs, the bundles are what ships
tools/node_modules/

# reference photos (large, third-party licences): sources.md is tracked, images are not
research/reference/*/img/

research/reference/square/*/*.jpg
research/reference/square/*/*.png
research/blender-detail/**/*.png
research/blender-detail/*.blend*
